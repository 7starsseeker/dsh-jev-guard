{
  "name": "dsh-jev-guard",
  "version": "0.5.1",
  "description": "Pre-execution safety valve for DeepSeek Harness: a TypeSafe Jev question decides whether a shell command/script would irreversibly delete or overwrite real data. Four states (allow/revise/block/escalate), mounted on tools/pre-execute. Zero dependencies; WSL/Linux (bash) and Windows (pwsh); one-shot tokens, credit-exhaustion degradation, shared audit log; bilingual (zh-CN / en) messages.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "guard",
    "safety",
    "destructive-command",
    "jev",
    "typesafe",
    "pre-execute",
    "audit-log"
  ],
  "type": "module",
  "main": "adapters/dsh/index.js",
  "exports": {
    ".": "./adapters/dsh/index.js",
    "./gate": "./lib/gate.js",
    "./rules": "./lib/rules.js",
    "./verdict": "./lib/verdict.js",
    "./audit": "./lib/audit.js",
    "./token": "./lib/token.js",
    "./quota": "./lib/quota.js",
    "./cli": "./bin/guard.mjs",
    "./adapters/dsh": "./adapters/dsh/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "jev-guard": "./bin/guard.mjs"
  },
  "scripts": {
    "selftest": "node bin/guard.mjs selftest",
    "rules": "node bin/guard.mjs rules",
    "judge": "node bin/guard.mjs judge",
    "status": "node bin/guard.mjs status",
    "log": "node bin/guard.mjs log --stats"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "bin",
    "lib",
    "adapters",
    "docs",
    "tools",
    "cordis.patch.yml",
    "config.example.json",
    "README.md",
    "README.zh-CN.md",
    "DEPLOY.md",
    "DEPLOY.zh-CN.md",
    "CHANGELOG.md",
    "CHANGELOG.zh-CN.md",
    "START-HERE.md",
    "START-HERE.zh-CN.md"
  ],
  "license": "MIT",
  "author": "7starsseeker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/7starsseeker/dsh-jev-guard.git"
  },
  "homepage": "https://github.com/7starsseeker/dsh-jev-guard#readme",
  "bugs": {
    "url": "https://github.com/7starsseeker/dsh-jev-guard/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
