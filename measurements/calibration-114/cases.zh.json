{
  "_about": "Jev 三臂校准测试样本集。每个 case 的 labels 是从文本中可客观推出的答案,不依赖主观判断。",
  "_arms": {
    "A": "中文 state + 中文 questions 直连 Jev",
    "B": "机器翻译(deepseek-flash 一次过)成英文后再问 Jev",
    "C": "翻译 + 回译校验(不一致则带反馈重译一次)后的英文再问 Jev"
  },
  "schemas": {
    "support": {
      "team": {
        "type": "choice",
        "instructions": "这个工单应该由哪个团队接手？",
        "criteria": {
          "billing": "账单金额、扣款、退款、发票、支付状态相关",
          "tech": "产品功能故障、报错、页面异常、登录与账号设置问题",
          "complaint": "客户表达投诉、举报、法务或监管威胁",
          "sales": "采购、报价、合同、批量席位等销售相关诉求"
        }
      },
      "refund": {
        "type": "noul",
        "instructions": "这个工单是否涉及退款、重复扣款或账单金额争议？",
        "criteria": {
          "true": "文本明确提出退款、重复扣款、退还费用或账单金额争议",
          "false": "文本只涉及功能问题、账号设置、咨询或销售诉求，没有金额争议"
        }
      },
      "urgent": {
        "type": "noul",
        "instructions": "这个工单是否需要立即处理（今天内）？",
        "criteria": {
          "true": "文本包含明确的紧急性信号：正在阻塞使用、马上要用、请尽快/今天回复、投诉或法务威胁",
          "false": "文本明确表示不着急、可以等流程、或只是普通咨询"
        }
      }
    },
    "ops": {
      "destructive": {
        "type": "noul",
        "instructions": "这条命令会不可逆地破坏用户数据吗？（可重建的缓存、临时文件不算破坏）",
        "criteria": {
          "true": "命令会不可逆地删除或覆盖真实数据：用户文档、源码、相册、日志、数据库、块设备内容",
          "false": "命令只读，或只影响可重建的缓存、临时文件、未使用的镜像"
        }
      },
      "action": {
        "type": "choice",
        "instructions": "执行这条命令前应该怎么做？",
        "criteria": {
          "run_now": "只读命令，或只影响可重建的缓存与临时文件，直接执行",
          "ask_human": "命令可能删除或覆盖用户的真实数据，但用户可能确实想要这个结果，需要先向用户确认",
          "refuse": "命令明确指向生产数据、块设备、系统日志等无正当理由的不可逆破坏，应当拒绝执行"
        }
      },
      "risk": {
        "type": "score",
        "instructions": "这条命令的风险等级？",
        "criteria": [
          "只读或可安全重建",
          "可能影响服务或误删部分真实数据",
          "不可逆丢数据或危及安全"
        ]
      }
    },
    "coding": {
      "regression": {
        "type": "noul",
        "instructions": "这次测试失败是本次改动引入的真实回归，而不是偶发失败（flaky）吗？",
        "criteria": {
          "true": "失败与本次改动的代码直接相关，且可稳定复现",
          "false": "失败与本次改动无关，或单独重跑即通过，属于偶发"
        }
      },
      "needs_human": {
        "type": "noul",
        "instructions": "这个改动需要人工审核后才能合并吗？",
        "criteria": {
          "true": "改动触及鉴权、支付、数据迁移、依赖大版本升级等高风险面",
          "false": "改动只涉及样式、文案、注释、拼写，或纯新增测试用例"
        }
      },
      "risk": {
        "type": "score",
        "instructions": "这次改动的风险等级？",
        "criteria": [
          "样式、文案、注释等无语义影响",
          "局部业务逻辑",
          "触及鉴权、支付、数据迁移或依赖大版本升级"
        ]
      }
    },
    "triage": {
      "relevant": {
        "type": "noul",
        "instructions": "这条搜索结果是否直接提供了该查询所要的答案或关键事实？",
        "criteria": {
          "true": "结果内容本身给出该问题的答案、关键事实或可操作的方法",
          "false": "结果主题跑偏、只是广告、或未提供任何可用信息"
        }
      },
      "source": {
        "type": "choice",
        "instructions": "这条结果的来源属于哪一类？",
        "criteria": {
          "official": "官方文档、官方博客或一手来源",
          "media": "新闻媒体或转载聚合",
          "forum": "社区问答、论坛帖或用户实测分享",
          "marketing": "营销推广、软文或带优惠码的推荐榜"
        }
      },
      "trust": {
        "type": "score",
        "instructions": "这条来源的可信度档位？",
        "criteria": [
          "低（营销软文、未署名转载）",
          "中（社区实测或二手媒体）",
          "高（官方文档或一手来源）"
        ]
      }
    }
  },
